{
  "meta": {
    "name": "Apex Design System",
    "version": "1.0.0",
    "description": "Core colors, typography, and spacing tokens serving as the single source of truth."
  },
  "colors": {
    "brand": {
      "primary": {
        "value": "#4F46E5",
        "cssVar": "--color-brand-primary",
        "description": "Primary actions, active states, and key highlights"
      },
      "primaryHover": {
        "value": "#4338CA",
        "cssVar": "--color-brand-primary-hover",
        "description": "Hover and pressed state for primary brand actions"
      },
      "primarySoft": {
        "value": "#EEF2FF",
        "cssVar": "--color-brand-primary-soft",
        "description": "Subtle tint for badges, pills, and selected rows"
      },
      "secondary": {
        "value": "#0EA5E9",
        "cssVar": "--color-brand-secondary",
        "description": "Secondary accents, data visuals, and info highlights"
      }
    },
    "semantic": {
      "success": {
        "value": "#10B981",
        "cssVar": "--color-semantic-success",
        "description": "Confirmations, positive metrics, and valid states"
      },
      "warning": {
        "value": "#F59E0B",
        "cssVar": "--color-semantic-warning",
        "description": "Caution banners and pending statuses"
      },
      "danger": {
        "value": "#EF4444",
        "cssVar": "--color-semantic-danger",
        "description": "Destructive actions and validation errors"
      },
      "info": {
        "value": "#3B82F6",
        "cssVar": "--color-semantic-info",
        "description": "Informational callouts and helper notices"
      }
    },
    "neutral": {
      "white": {
        "value": "#FFFFFF",
        "cssVar": "--color-neutral-white",
        "description": "Pure white surface and inverse text"
      },
      "gray50": {
        "value": "#F8FAFC",
        "cssVar": "--color-neutral-50",
        "description": "Light mode page canvas background"
      },
      "gray100": {
        "value": "#F1F5F9",
        "cssVar": "--color-neutral-100",
        "description": "Subtle recessed surfaces and code blocks"
      },
      "gray200": {
        "value": "#E2E8F0",
        "cssVar": "--color-neutral-200",
        "description": "Default card borders and hairlines"
      },
      "gray400": {
        "value": "#94A3B8",
        "cssVar": "--color-neutral-400",
        "description": "Muted icons and placeholder text"
      },
      "gray600": {
        "value": "#475569",
        "cssVar": "--color-neutral-600",
        "description": "Secondary body copy and metadata"
      },
      "gray800": {
        "value": "#1E293B",
        "cssVar": "--color-neutral-800",
        "description": "Dark mode elevated cards and containers"
      },
      "gray900": {
        "value": "#0F172A",
        "cssVar": "--color-neutral-900",
        "description": "Primary headings in light mode / dark canvas"
      }
    }
  },
  "fonts": {
    "families": {
      "sans": {
        "value": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "cssVar": "--font-sans",
        "label": "Plus Jakarta Sans",
        "description": "Primary UI and editorial display typeface"
      },
      "mono": {
        "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
        "cssVar": "--font-mono",
        "label": "JetBrains Mono",
        "description": "Token identifiers, code snippets, and numerical metrics"
      }
    },
    "sizes": {
      "xs": { "value": "0.75rem", "px": "12px", "cssVar": "--text-xs", "sample": "Caption & micro-labels" },
      "sm": { "value": "0.875rem", "px": "14px", "cssVar": "--text-sm", "sample": "Secondary UI controls & metadata" },
      "base": { "value": "1rem", "px": "16px", "cssVar": "--text-base", "sample": "Default body paragraph reading size" },
      "lg": { "value": "1.125rem", "px": "18px", "cssVar": "--text-lg", "sample": "Lead paragraphs & card titles" },
      "xl": { "value": "1.25rem", "px": "20px", "cssVar": "--text-xl", "sample": "Subsection heading clarity" },
      "2xl": { "value": "1.5rem", "px": "24px", "cssVar": "--text-2xl", "sample": "Section headers & visual anchors" },
      "3xl": { "value": "2rem", "px": "32px", "cssVar": "--text-3xl", "sample": "Page titles & feature headlines" },
      "4xl": { "value": "2.75rem", "px": "44px", "cssVar": "--text-4xl", "sample": "Hero display statement" }
    },
    "weights": {
      "regular": { "value": "400", "cssVar": "--font-weight-regular" },
      "medium": { "value": "500", "cssVar": "--font-weight-medium" },
      "semibold": { "value": "600", "cssVar": "--font-weight-semibold" },
      "bold": { "value": "700", "cssVar": "--font-weight-bold" }
    }
  },
  "spacing": {
    "1": { "value": "0.25rem", "px": "4px", "cssVar": "--space-1", "usage": "Tight icon gaps" },
    "2": { "value": "0.5rem", "px": "8px", "cssVar": "--space-2", "usage": "Inline element spacing" },
    "3": { "value": "0.75rem", "px": "12px", "cssVar": "--space-3", "usage": "Compact input padding" },
    "4": { "value": "1rem", "px": "16px", "cssVar": "--space-4", "usage": "Standard grid gap & card padding" },
    "5": { "value": "1.25rem", "px": "20px", "cssVar": "--space-5", "usage": "Medium component spacing" },
    "6": { "value": "1.5rem", "px": "24px", "cssVar": "--space-6", "usage": "Card internal padding" },
    "8": { "value": "2rem", "px": "32px", "cssVar": "--space-8", "usage": "Group & layout separation" },
    "10": { "value": "2.5rem", "px": "40px", "cssVar": "--space-10", "usage": "Subsection breathing room" },
    "12": { "value": "3rem", "px": "48px", "cssVar": "--space-12", "usage": "Major section padding" },
    "16": { "value": "4rem", "px": "64px", "cssVar": "--space-16", "usage": "Hero & top-level vertical rhythm" }
  }
}